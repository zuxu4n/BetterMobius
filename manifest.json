{
  "manifest_version": 3,
  "name": "BetterMobius",
  "version": "1.0.0",
  "description": "Unofficial helper for Möbius lectures: playback speed, jump between sentences, drawing tools and a calculator.",
  "homepage_url": "https://github.com/zuxu4n/BetterMobius",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.mobius.cloud/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
